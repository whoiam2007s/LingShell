{
  "name": "@lingshell/desktop",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "灵壳 LingShell — AI terminal and operations workbench",
  "author": "BigZ <whoiam2007s@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoiam2007s/LingShell.git"
  },
  "homepage": "https://github.com/whoiam2007s/LingShell#readme",
  "bugs": {
    "url": "https://github.com/whoiam2007s/LingShell/issues"
  },
  "keywords": [
    "lingshell",
    "electron",
    "terminal",
    "ssh",
    "devops",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-builder --config electron-builder.config.cjs --publish never",
    "dist:win": "electron-builder --config electron-builder.config.cjs --publish never --win",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --publish never --mac",
    "dist:linux": "electron-builder --config electron-builder.config.cjs --publish never --linux",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --retry 2 --testTimeout 30000 --hookTimeout 60000"
  },
  "dependencies": {
    "@lingshell/auth-registry": "workspace:*",
    "@lingshell/config": "workspace:*",
    "@lingshell/dsh-controller": "workspace:*",
    "@lingshell/platform": "workspace:*",
    "@lingshell/shared": "workspace:*",
    "@lingshell/terminal-core": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
