{
  "name": "lingshell",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "LingShell — AI terminal and operations workbench",
  "author": "BigZ <whoiam2007s@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoiam2007s/LingShell.git"
  },
  "homepage": "https://github.com/whoiam2007s/LingShell#readme",
  "bugs": {
    "url": "https://github.com/whoiam2007s/LingShell/issues"
  },
  "keywords": [
    "lingshell",
    "electron",
    "terminal",
    "ssh",
    "devops",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -k -n UI,APP -c cyan,green \"pnpm dev:ui\" \"pnpm dev:desktop\"",
    "dev:ui": "pnpm --filter @lingshell/ui dev",
    "dev:desktop": "wait-on tcp:127.0.0.1:5183 && cross-env LINGSHELL_RENDERER_URL=http://127.0.0.1:5183 pnpm --filter @lingshell/desktop dev",
    "build:libs": "turbo run build --filter=@lingshell/shared --filter=@lingshell/terminal-core --filter=@lingshell/dsh-controller --filter=@lingshell/config",
    "build:ui": "pnpm --filter @lingshell/ui build",
    "build:desktop": "pnpm --filter @lingshell/desktop build",
    "build": "pnpm build:libs && pnpm build:ui && pnpm build:desktop",
    "dist": "pnpm build && pnpm --filter @lingshell/desktop dist",
    "dist:win": "pnpm build && pnpm --filter @lingshell/desktop dist:win",
    "test": "turbo run test --concurrency=2",
    "test:ci": "turbo run test --concurrency=2 -- --exclude \"**/*.real.test.ts\"",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "i18n:check": "node scripts/i18n-check.mjs",
    "sbom": "node scripts/sbom.mjs",
    "check:tdz": "node scripts/check-tdz.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "check:boundaries": "eslint apps/desktop/src apps/ui/src packages/shared/src",
    "check:structure": "node scripts/check-tdz.mjs && node scripts/check-protocol.mjs && eslint apps/desktop/src apps/ui/src packages/shared/src"
  },
  "devDependencies": {
    "turbo": "2.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "globals": "17.7.0",
    "vitest": "4.1.9",
    "concurrently": "10.0.3",
    "wait-on": "9.0.10",
    "cross-env": "10.1.0"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
      "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
      "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.2",
      "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
      "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
      "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
      "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
      "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
      "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
      "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2",
      "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.2",
      "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.2",
      "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
      "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
      "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
      "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
      "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2",
      "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
      "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
      "@deepseek-ai/dsh-session": "0.2.1-rc.2",
      "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
      "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
      "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
      "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
      "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
      "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
      "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
      "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
      "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
      "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
      "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.2",
      "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-rc.2",
      "@deepseek-ai/cordis": "4.0.5",
      "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
      "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
      "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
      "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
      "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
      "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
      "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
      "@earendil-works/pi-ai": "1.3.0"
    }
  }
}
